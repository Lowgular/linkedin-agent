{
  "model": "haiku",
  "disableClaudeAiConnectors": true,
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "mcp__browser-mcp",
      "Read",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash",
      "Write",
      "Edit",
      "MultiEdit",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Task"
    ]
  }
}
