{
  "mcpServers": {
    "browser-mcp": {
      "url": "http://127.0.0.1:9333/mcp",
      "type": "http",
      "trust": true
    }
  },
  "model": {
    "name": "gemini-3.5-flash-lite"
  },
  "context": {
    "fileName": [
      "AGENTS.md"
    ]
  },
  "tools": {
    "exclude": [
      "run_shell_command",
      "write_file",
      "replace",
      "web_fetch",
      "google_web_search",
      "save_memory"
    ]
  }
}
