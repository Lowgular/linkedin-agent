# Copy to .env (never committed). One key runs the agent: get it at https://aistudio.google.com/apikey.
# The model is gemini-3.8-flash (.gemini/settings.json), billed per token: a task is a few cents. Gemma on this
# API is capped at 16k input tokens a minute, below one turn of this agent, so it cannot run it.
GEMINI_API_KEY=

# The eval's grader reads each answer with Claude Haiku: one of these (docker compose run --rm eval).
ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=

# Tracing to Google Cloud (optional, for whoever runs the demo): the project whose Cloud Trace, Cloud Logging
# and Cloud Monitoring receive every model request and tool call. Needs `gcloud auth application-default login`
# on this machine and the three APIs enabled on the project. Leave empty and nothing is exported.
GOOGLE_CLOUD_PROJECT=
# Starts the collector that ships the traces; leave commented out when no project is set.
# COMPOSE_PROFILES=trace
# Where gcloud keeps its credentials, when not the default ~/.config/gcloud (Windows: %APPDATA%\gcloud).
# GCLOUD_CONFIG_DIR=
