# Dockerfile.gemini-cli — DEPRECATED: the agent image as it was on Gemini CLI, which Google retired for individual
# accounts in June 2026 in favour of Antigravity CLI (Dockerfile). It still runs on a paid API key and is kept for
# the Cloud Trace export, which Antigravity CLI does not have: docker compose --profile gemini-cli run --rm agent-gemini-cli.
# Node and Gemini CLI, nothing else. compose.yaml runs it with this folder mounted
# at /app, so the CLI starts in the agent folder and reads its brief, wiki and settings from the checkout, where
# you edit them; its browser tools are their own service (mcp/browser-mcp), at 127.0.0.1:9333 as
# .gemini/settings.json says. The key comes from .env; the auth method is chosen here once, so the CLI never
# asks, and /app is trusted, since the CLI disables a folder's MCP servers until its folder is. The CLI's
# self-update is off: the version is the one pinned here, and a fresh container would otherwise update every run.
# One patch to the CLI: its user_prompt span — the root of every turn — is opened without the telemetry flags, so
# the CLI leaves the prompt off it and a trace shows no question, only the CLI's own description. The sed passes
# the flags as the CLI's other spans do, in each of the bundle's builds of the interactive CLI; the grep fails the
# build when a new version no longer has that line.
# Published as ghcr.io/lowgular/linkedin-agent for anyone who prefers a pull to a build.
FROM node:24-slim
LABEL org.opencontainers.image.source="https://github.com/Lowgular/linkedin-agent" \
      org.opencontainers.image.description="Gemini CLI (deprecated) for the linkedin-agent folder, mounted at /app"
RUN apt-get update && apt-get install -y --no-install-recommends git curl ca-certificates && rm -rf /var/lib/apt/lists/* \
 && npm install -g @google/gemini-cli@0.67.0 \
 && cd /usr/local/lib/node_modules/@google/gemini-cli/bundle \
 && sed -i -E 's#: (GeminiCliOperation\.UserPrompt|"user_prompt" /\* UserPrompt \*/),#&  tracesEnabled: config.getTelemetryTracesEnabled(), logPrompts: config.getTelemetryLogPromptsEnabled(),#' interactiveCli-*.js \
 && for f in interactiveCli-*.js; do grep -q 'UserPrompt[^,]*,  tracesEnabled' "$f" || exit 1; done \
 && mkdir -p /root/.gemini \
 && echo '{"security":{"auth":{"selectedType":"gemini-api-key"},"folderTrust":{"enabled":false}},"general":{"disableAutoUpdate":true,"disableUpdateNag":true}}' > /root/.gemini/settings.json \
 && echo '{"/app":"TRUST_FOLDER"}' > /root/.gemini/trustedFolders.json
WORKDIR /app
CMD ["gemini"]
