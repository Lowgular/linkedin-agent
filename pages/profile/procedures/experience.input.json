{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "run": {
      "type": "string",
      "pattern": "^[a-f0-9]{16}$",
      "description": "Session ID from dev-browser session_start"
    },
    "tab": {
      "type": "string",
      "pattern": "^[a-f0-9]{16}$",
      "description": "Tab ID belonging to this run"
    }
  },
  "required": [
    "run",
    "tab"
  ]
}